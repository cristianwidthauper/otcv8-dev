DeathWindow < MainWindow
  id: deathWindow
  !text: tr('Você morreu')
  &baseWidth: 350
  &baseHeight: 15

  Label
    id: labelText
    text-align: center
    width: 330
    height: 55
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 10
    margin-top: 12

  Button
    id: buttonOk
    !text: tr('Ok')
    width: 90
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
